{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArchitecturePlan v1", "type": "object",
  "required": ["schema_version", "goal_revision", "title", "components", "interfaces", "dependencies", "entrypoints", "acceptance", "intelligence_profile_id", "decisions"],
  "properties": {
    "schema_version": {"const": 1}, "goal_revision": {"type": "integer", "minimum": 1}, "title": {"type": "string", "minLength": 1},
    "components": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "kind"], "properties": {"id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}}}},
    "interfaces": {"type": "array", "items": {"type": "object", "required": ["id", "from", "to"], "properties": {"id": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}}}},
    "dependencies": {"type": "array", "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}},
    "entrypoints": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "component_id", "argv"], "properties": {"id": {"type": "string"}, "component_id": {"type": "string"}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "requirement_ids", "verifier", "config"], "properties": {"id": {"type": "string", "minLength": 1}, "requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "verifier": {"type": "string", "minLength": 1}, "config": {"type": "object"}}}},
    "intelligence_profile_id": {"type": ["string", "null"]},
    "decisions": {"type": "array", "items": {"type": "object", "required": ["id", "question", "consequential"], "properties": {"id": {"type": "string"}, "question": {"type": "string"}, "consequential": {"type": "boolean"}}}},
    "extensions": {"type": "object"}
  }
}
